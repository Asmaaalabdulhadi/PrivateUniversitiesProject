    <form id="myForm" method="get">
      <input type="number" id="cid" name="cid" placeholder="ادخل رقم الطالب المدني"><br>
      <input id="search" type="submit" value="SEARCH" formaction="/search">
    </form>     


    <table>
      <tr>
        <th>اسم الطالب</th>
        <th>حالة الطالب</th>
        <th>المطالبات المالية</th>
        <th>اخر تحديث</th>
      </tr>
    <ul id="postsList">
      <% students.forEach(student=> { %>    

      <tr>
        <td><%=student.StudentName%></td>
        <td><%=student.Status %></td>
        <td> <%=student.Debt%></td>
        <td> <%=student.UpdateDate%> </td>
      </tr>


        </li>
        <% }); %>
    </ul>
